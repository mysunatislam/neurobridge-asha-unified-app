          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "active": false,
  "meta": {
    "description": "When a patient confirms a request in ASHA, wait, check whether the caregiver acknowledged it, and if not send the caregiver a reminder. Signed with HMAC-SHA256 both ways; carries ids and the request kind only."
  }
}