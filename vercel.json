{
  "framework": null,
  "functions": { "api/*.js": { "maxDuration": 30 } },
  "crons": [{ "path": "/api/cleanup", "schedule": "17 3 * * *" }],
  "redirects": [
    {
      "source": "/caregiver/:path*",
      "destination": "/?role=caregiver",
      "permanent": false
    },
    {
      "source": "/patient/:path*",
      "destination": "/?role=patient",
      "permanent": false
    },
    {
      "source": "/neuroface",
      "destination": "/?module=facespeak",
      "permanent": false
    },
    {
      "source": "/neuroface/fingerspeak.html",
      "destination": "/?module=fingerspeak",
      "permanent": false
    },
    {
      "source": "/senseassist/:path*",
      "destination": "/?module=senseassist",
      "permanent": false
    },
    {
      "source": "/vitalsense/:path*",
      "destination": "/?module=vitalsense",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/care", "destination": "/index.html" },
    { "source": "/patient", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
