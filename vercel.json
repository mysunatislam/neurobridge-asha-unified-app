{
  "framework": null,
  "functions": { "api/*.js": { "maxDuration": 60 } },
  "crons": [{ "path": "/api/cleanup", "schedule": "17 3 * * *" }],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "module" }],
      "destination": "/app",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "role" }],
      "destination": "/app",
      "permanent": false
    },
    {
      "source": "/caregiver/:path*",
      "destination": "/?role=caregiver",
      "permanent": false
    },
    {
      "source": "/patient/:path*",
      "destination": "/?role=patient",
      "permanent": false
    },
    {
      "source": "/neuroface",
      "destination": "/?module=facespeak",
      "permanent": false
    },
    {
      "source": "/senseassist/:path*",
      "destination": "/?module=senseassist",
      "permanent": false
    },
    {
      "source": "/vitalsense/:path*",
      "destination": "/?module=vitalsense",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/app/", "destination": "/app.html" },
    { "source": "/care", "destination": "/app.html" },
    { "source": "/patient", "destination": "/app.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
